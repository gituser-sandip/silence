{
  "version": 2,
  "installCommand": "npm --prefix client ci && npm --prefix server ci",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
